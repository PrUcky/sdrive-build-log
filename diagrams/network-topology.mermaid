---
title: sdrive Network Topology (Week 05 — with Tailscale Overlay)
---
graph TD
    subgraph PHONE["Phone (Ente App)"]
        APP["Ente Client<br/>XChaCha20-Poly1305"]
        TS_PHONE["Tailscale<br/>100.100.64.11"]
    end

    subgraph INTERNET["Internet"]
        CARRIER_NAT["Carrier CGNAT<br/>10.x.x.x → public"]
        ISP_NAT["ISP CGNAT<br/>100.64.x.x → public"]
        TS_CONTROL["Tailscale Control<br/>login.tailscale.com<br/>(coordination only)"]
        DERP["DERP Relay<br/>(fallback only)<br/>encrypted e2e"]
    end

    subgraph HOME["Home Network"]
        ROUTER["Router<br/>192.168.1.1<br/>WAN: 100.64.0.10 (CGNAT)"]

        subgraph ROCK["ROCK 3C (sdrive) — 192.168.1.150"]
            UFW["UFW Firewall<br/>SSH :22 (LAN)<br/>Museum :8080 (LAN)<br/>tailscale0 (all)"]
            TS_DAEMON["tailscaled<br/>100.100.42.17<br/>UDP :41641"]

            subgraph DOCKER["Docker Bridge (172.18.0.0/16)"]
                MUSEUM["Museum<br/>Go Backend<br/>:8080<br/>122 MB RSS"]
                GARAGE["Garage<br/>Rust S3<br/>:3900/:3903<br/>28 MB RSS"]
                POSTGRES["PostgreSQL 16<br/>:5432<br/>38 MB RSS"]
            end

            SSD["/mnt/data (USB SSD)<br/>ext4, noatime, discard<br/>458 GB"]
        end
    end

    %% Local data path
    APP -->|"encrypted photos<br/>HTTP :8080"| MUSEUM
    MUSEUM -->|"metadata<br/>:5432"| POSTGRES
    MUSEUM -->|"S3 PUT/GET<br/>:3900"| GARAGE
    GARAGE -->|"Blake2 blocks"| SSD
    POSTGRES -->|"WAL + data"| SSD

    %% Tailscale overlay
    TS_PHONE -.->|"WireGuard tunnel<br/>(direct, ~3ms LAN / ~45ms mobile)"| TS_DAEMON
    TS_PHONE -.->|"key exchange"| TS_CONTROL
    TS_DAEMON -.->|"key exchange"| TS_CONTROL
    TS_PHONE -.->|"fallback relay"| DERP
    DERP -.->|"fallback relay"| TS_DAEMON

    %% NAT traversal
    TS_PHONE -->|"hole-punch"| CARRIER_NAT
    CARRIER_NAT -->|"UDP"| ISP_NAT
    ISP_NAT -->|"UDP"| ROUTER
    ROUTER -->|"UDP :41641"| TS_DAEMON

    %% Tunnel to app
    TS_DAEMON -->|"decrypted to<br/>tailscale0"| UFW
    UFW -->|":8080"| MUSEUM

    classDef phone fill:#4CAF50,stroke:#333,color:#fff
    classDef internet fill:#FF9800,stroke:#333,color:#fff
    classDef router fill:#2196F3,stroke:#333,color:#fff
    classDef container fill:#9C27B0,stroke:#333,color:#fff
    classDef storage fill:#795548,stroke:#333,color:#fff
    classDef tailscale fill:#0EA5E9,stroke:#333,color:#fff

    class APP,TS_PHONE phone
    class CARRIER_NAT,ISP_NAT,TS_CONTROL,DERP internet
    class ROUTER router
    class MUSEUM,GARAGE,POSTGRES container
    class SSD storage
    class TS_DAEMON,UFW tailscale
